# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#FFFFFF"

# Title color for boxes
theme[title]="#FFFFFF"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#d4a37e"

# Background color of selected item in processes box. #FFFFFF maps to
# the foreground role in omarchy (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a1a1a gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a1a1a"

# Foreground color of selected item in processes box. Use #FFFFFF so
# the row text stays readable on the lighter_bg highlight; the previous
# #937478 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#FFFFFF"

# Color of inactive/disabled text
theme[inactive_fg]="#686163"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #ffffff caps at #ffffff when the foreground is already pure white, so we
# just bind it to #FFFFFF directly.
theme[graph_text]="#FFFFFF"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #FFFFFF collapsed to the main fg.
theme[meter_bg]="#1a1a1a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #7da38b for a distinct accent instead of #ffffff which capped to white.
theme[proc_misc]="#7da38b"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#9a6e7a"
theme[mem_box]="#8b9a6d"
theme[net_box]="#c06b5e"
theme[proc_box]="#d4a37e"

# Box divider line and small boxes line color
theme[div_line]="#686163"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#8b9a6d"
theme[temp_mid]="#d4a24a"
theme[temp_end]="#c06b5e"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#7da38b"
theme[cpu_mid]="#d4a37e"
theme[cpu_end]="#9a6e7a"

# Mem/Disk free meter
theme[free_start]="#9a6e7a"
theme[free_mid]="#d4a37e"
theme[free_end]="#7da38b"

# Mem/Disk cached meter
theme[cached_start]="#d4a37e"
theme[cached_mid]="#7da38b"
theme[cached_end]="#9a6e7a"

# Mem/Disk available meter
theme[available_start]="#d4a24a"
theme[available_mid]="#c06b5e"
theme[available_end]="#c06b5e"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#8b9a6d"
theme[used_mid]="#7da38b"
theme[used_end]="#d4a37e"

# Download graph colors
theme[download_start]="#d4a24a"
theme[download_mid]="#c06b5e"
theme[download_end]="#c06b5e"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#8b9a6d"
theme[upload_mid]="#7da38b"
theme[upload_end]="#d4a37e"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#7da38b"
theme[process_mid]="#d4a37e"
theme[process_end]="#9a6e7a"
