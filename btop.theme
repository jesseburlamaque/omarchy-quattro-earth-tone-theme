# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#FFFFFF"

# Title color for boxes
theme[title]="#FFFFFF"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#937478"

# Background color of selected item in processes box. #FFFFFF maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a1a1a gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a1a1a"

# Foreground color of selected item in processes box. Use #FFFFFF so
# the row text stays readable on the lighter_bg highlight; the previous
# #937478 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#FFFFFF"

# Color of inactive/disabled text
theme[inactive_fg]="#686163"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #ffffff caps at #ffffff when the foreground is already pure white, so we
# just bind it to #FFFFFF directly.
theme[graph_text]="#FFFFFF"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #FFFFFF collapsed to the main fg.
theme[meter_bg]="#1a1a1a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #e9d4ae for a distinct accent instead of #ffffff which capped to white.
theme[proc_misc]="#e9d4ae"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#c69e9a"
theme[mem_box]="#d3bba2"
theme[net_box]="#a78c83"
theme[proc_box]="#937478"

# Box divider line and small boxes line color
theme[div_line]="#686163"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#d3bba2"
theme[temp_mid]="#ffe7cc"
theme[temp_end]="#a78c83"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#e9d4ae"
theme[cpu_mid]="#937478"
theme[cpu_end]="#c69e9a"

# Mem/Disk free meter
theme[free_start]="#c69e9a"
theme[free_mid]="#937478"
theme[free_end]="#e9d4ae"

# Mem/Disk cached meter
theme[cached_start]="#937478"
theme[cached_mid]="#e9d4ae"
theme[cached_end]="#c69e9a"

# Mem/Disk available meter
theme[available_start]="#ffe7cc"
theme[available_mid]="#a78c83"
theme[available_end]="#a78c83"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#d3bba2"
theme[used_mid]="#e9d4ae"
theme[used_end]="#937478"

# Download graph colors
theme[download_start]="#ffe7cc"
theme[download_mid]="#a78c83"
theme[download_end]="#a78c83"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#d3bba2"
theme[upload_mid]="#e9d4ae"
theme[upload_end]="#937478"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#e9d4ae"
theme[process_mid]="#937478"
theme[process_end]="#c69e9a"
